# Postgres (same DB as portfolio)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=karan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
POSTGRES_ECHO=false

# MongoDB (Atlas free tier — optional, for future use)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DB_NAME=all_projects

# Garage (same bucket as portfolio, different key prefix)
GARAGE_ENDPOINT_URL=http://localhost:3900
GARAGE_ACCESS_KEY=change-me
GARAGE_SECRET_KEY=change-me
GARAGE_BUCKET_NAME=portfolio-media
GARAGE_REGION_NAME=garage

# Runtime ("production" disables /docs, /redoc, /openapi.json and drops localhost CORS origins)
ENVIRONMENT=development

# SSO (shared karan_sso SDK — see SSO_CONTRACT.md §5)
# Internal SSO API base (prod: http://sso-backend:8000/api)
SSO_BASE_URL=http://localhost:8000/api
# JWT `iss` (prod: https://auth.karanparmar.in/api/auth). Empty = don't check.
SSO_ISSUER=
SSO_AUDIENCE=karanparmar-apps
# true once SSO sets JWT_AUDIENCE
SSO_REQUIRE_AUDIENCE=false
# This app's id in SSO (app-scoped "admin" role)
SSO_APP_ID=allprojects
# Legacy HS256 secret (= SSO JWT_SECRET) — only while SSO still signs HS256; remove after rollout
SSO_JWT_SECRET=

# CORS — explicit origins only (localhost origins are ignored when ENVIRONMENT=production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:1576,http://localhost:1577,http://localhost:4173,http://localhost:4174

# Media limits
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_DOCUMENT_BYTES=10485760
MEDIA_ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/svg+xml,image/avif
MEDIA_ALLOWED_DOCUMENT_TYPES=application/pdf
MEDIA_CACHE_MAX_AGE_SECONDS=31536000
PUBLIC_API_URL=http://localhost:8002
